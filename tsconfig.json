{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["bun"]
  },
  "include": ["server/**/*.ts", "src/**/*.ts", "tests/**/*.ts", ".railway/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
