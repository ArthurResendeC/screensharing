# Frontend: default ws://<current hostname>:3001 on HTTP, wss:// on HTTPS.
# For a reverse proxy you can set wss://share.example.com/signaling
# NEXT_PUBLIC_SIGNALING_URL=wss://share.example.com/signaling
SIGNALING_PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Direct WSS development: use a certificate trusted by BOTH machines.
# SIGNALING_TLS_CERT=certificates/localhost.pem
# SIGNALING_TLS_KEY=certificates/localhost-key.pem
# Optional, per spectator; 0 disables the cap. Browser may use less.
NEXT_PUBLIC_MAX_VIDEO_BITRATE=15000000
# TURN credentials are visible to clients; use short-lived credentials for deployment.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=example
# NEXT_PUBLIC_TURN_CREDENTIAL=example
