# Bun serve frontend e signaling na mesma origem. Railway fornece PORT.
PORT=3000
# Segredo estável usado para assinar convites. Use pelo menos 32 caracteres aleatórios
# e mantenha o mesmo valor entre deploys; trocá-lo invalida todos os convites existentes.
ROOM_TOKEN_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres
# Origens adicionais, separadas por vírgula. A mesma origem já é permitida.
# ALLOWED_ORIGINS=https://share.example.com
# Teto opcional por espectador; 0 desativa. O navegador pode usar menos.
MAX_VIDEO_BITRATE=15000000
# Piso e estimativa inicial (bps) para manter o bitrate estável quando a tela fica
# parada e volta a se mover. Chrome/Edge apenas; 0 desativa cada um.
MIN_VIDEO_BITRATE=2500000
START_VIDEO_BITRATE=8000000
# TURN credentials are visible to clients; use short-lived credentials for deployment.
# No modo cloudflare o próprio SFU já expõe um IP público + STUN; o TURN é opcional.
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=example
# TURN_CREDENTIAL=example

# Camada de mídia: "webrtc" (malha P2P, padrão) ou "cloudflare" (SFU Cloudflare
# Realtime). Trocar aqui e reiniciar troca o transporte de toda sessão nova, sem
# novo build do frontend.
MEDIA_PROVIDER=webrtc
# Obrigatórias quando MEDIA_PROVIDER=cloudflare. Crie um app em
# dash.cloudflare.com → Realtime → SFU. O App Secret NUNCA sai do servidor
# (o navegador só fala com /realtime/* na mesma origem).
# CLOUDFLARE_REALTIME_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLOUDFLARE_REALTIME_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Limite opcional de tamanho de sala, verificado ao entrar. Vale nos dois modos.
# Ausente = sem limite.
# MAX_ROOM_PARTICIPANTS=10
