{
  "name": "private-screen-share",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "build": "bun build --target=bun --production --outdir=dist server/index.ts",
    "icons:pwa": "bun run scripts/generate-pwa-icons.ts",
    "start": "bun --cwd dist index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test ./tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "railway": "^3.11.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "bun@1.4.2"
}
